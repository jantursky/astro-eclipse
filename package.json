{
  "name": "astro-eclipse-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.23.4",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter example dev",
    "dev:docs": "bun run --filter docs dev",
    "build": "bun run build:lib && bun run --filter example build",
    "build:docs": "bun run build:lib && bun run --filter docs build",
    "test:e2e": "bun run build && bun run --filter example test:e2e",
    "build:lib": "bun run --filter astro-eclipse build",
    "lint:package": "bun run --filter astro-eclipse lint:package",
    "test": "bun run --filter astro-eclipse test",
    "test:coverage": "bun run --filter astro-eclipse test:coverage",
    "test:pack": "bun run --filter astro-eclipse test:pack",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-astro": "^3",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3",
    "prettier-plugin-astro": "^1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  },
  "overrides": {
    "@pierre/diffs": "1.6.1"
  }
}
