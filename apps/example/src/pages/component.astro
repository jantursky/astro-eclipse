---
import { ThemeRadio, ThemeSelect, ThemeToggle } from 'astro-eclipse/components'
import Base from '../layouts/Base.astro'
---

<Base title="ThemeToggle: Astro Eclipse">
  <section class="wrap head">
    <div class="stack">
      <span class="label">Component</span>
      <h1 class="title">ThemeToggle</h1>
      <p class="lede">
        A real button that cycles themes. Its accessible name says the current theme and the next one, and it works from
        the keyboard.
      </p>
    </div>
  </section>
  <section class="wrap section">
    <div class="card stack">
      <h2>Default: every theme, config effect</h2>
      <ThemeToggle data-testid="default" />
      <h2>Two themes, wipe</h2>
      <ThemeToggle themes={['light', 'dark']} transition="wipe" direction="down" />
      <p class="caption">
        <a href="/navigation/a">Go to a navigation page</a>: the buttons keep working there.
      </p>
    </div>
  </section>
  <section class="wrap head">
    <div class="stack">
      <span class="label">Component</span>
      <h2 class="title">ThemeSelect</h2>
      <p class="lede">
        A native select that lists the themes and a System option. It shows your preference, so System stays selected
        while the page is dark.
      </p>
    </div>
  </section>
  <section class="wrap section">
    <div class="card stack">
      <h2>Default: every theme plus System</h2>
      <ThemeSelect data-testid="select-default" />
      <h2>Custom labels, wipe</h2>
      <ThemeSelect
        data-testid="select-labels"
        label="Farbschema"
        labels={{ light: 'Hell', dark: 'Dunkel', system: 'Automatisch' }}
        transition="wipe"
        direction="down"
      />
      <h2>Two themes, no System</h2>
      <ThemeSelect data-testid="select-plain" themes={['light', 'dark']} system={false} />
    </div>
  </section>
  <section class="wrap head">
    <div class="stack">
      <span class="label">Component</span>
      <h2 class="title">ThemeRadio</h2>
      <p class="lede">
        A radio group that shows every choice at once. It follows your preference, so System stays checked while the
        page is dark, and arrow keys move between the options.
      </p>
    </div>
  </section>
  <section class="wrap section">
    <div class="card stack">
      <h2>Default: every theme plus System</h2>
      <ThemeRadio data-testid="radio-default" />
      <h2>Custom labels and name, wipe</h2>
      <ThemeRadio
        data-testid="radio-labels"
        label="Farbschema"
        labels={{ light: 'Hell', dark: 'Dunkel', system: 'Automatisch' }}
        transition="wipe"
        direction="down"
      />
      <h2>Two themes, no System</h2>
      <ThemeRadio data-testid="radio-plain" themes={['light', 'dark']} system={false} />
    </div>
  </section>
  <section class="wrap head">
    <div class="stack">
      <span class="label">Headless</span>
      <h2 class="title">data-eclipse-set</h2>
      <p class="lede">
        Any element with <code>data-eclipse-set</code> switches the theme on click, with no script of your own. This is
        what markdown or CMS content can use.
      </p>
    </div>
  </section>
  <section class="wrap section">
    <div class="card stack">
      <p data-testid="headless">
        Switch to{' '}
        <a href="#" data-eclipse-set="dark">
          dark
        </a>
        ,{' '}
        <a href="#" data-eclipse-set="sepia">
          sepia
        </a>{' '}
        or
        <a href="#" data-eclipse-set="system">
          the system theme
        </a>
        .
      </p>
      <p>
        <button
          class="btn btn-ghost"
          type="button"
          data-testid="headless-wipe"
          data-eclipse-set="light"
          data-transition="wipe"
          data-direction="down"
        >
          Light, wipe down
        </button>
      </p>
    </div>
  </section>
</Base>
