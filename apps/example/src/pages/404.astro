---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found: Astro Eclipse">
  <section class="wrap" style="padding-top: 64px">
    <div class="stack">
      <span class="label">404</span>
      <h1 style="font-size: clamp(2.5rem, 5vw + 1rem, 4.5rem)">This page does not exist.</h1>
      <p class="lede">The theme still works here, though. Use the toggle in the header.</p>
      <a class="btn btn-primary" href="/">
        Back to the start
      </a>
    </div>
  </section>
</Base>
