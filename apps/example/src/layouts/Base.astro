---
import '@fontsource-variable/inter'
import { ClientRouter } from 'astro:transitions'
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Animated theme transitions for Astro. No flash, survives ClientRouter navigation.' } =
  Astro.props
const path = Astro.url.pathname.replace(/\/$/, '')
const nav = [
  { href: '/gallery', label: 'Gallery', section: '/gallery' },
  { href: '/component', label: 'Component', section: '/component' },
  { href: '/navigation/a', label: 'Navigation', section: '/navigation' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
  </head>
  <body>
    <header class="header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>astro-eclipse</span>
        </a>
        <nav aria-label="Main" class="nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.section) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a href="https://astro-eclipse-docs.vercel.app" rel="noopener">
            Docs
          </a>
          <a href="https://github.com/jantursky/astro-eclipse" rel="noopener">
            GitHub
          </a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap foot">
        <p class="muted">astro-eclipse is MIT licensed. This site is its live demo.</p>
        <p class="links">
          <a href="https://astro-eclipse-docs.vercel.app" rel="noopener">
            Documentation
          </a>
          <a href="https://www.npmjs.com/package/astro-eclipse" rel="noopener">
            npm
          </a>
          <a href="https://github.com/jantursky/astro-eclipse" rel="noopener">
            GitHub
          </a>
        </p>
      </div>
    </footer>
    <script>
      import '../scripts/theme-controls'
    </script>
  </body>
</html>

<style>
  .header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    min-height: 56px;
    padding-block: 8px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 500;
    border-radius: var(--radius);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-right: auto;
  }
  .nav a {
    text-decoration: none;
    font-weight: 500;
    color: var(--text-muted);
    padding: 8px 0;
    border-radius: var(--radius);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--text);
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--accent-edge);
  }
  .footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--border);
    padding-block: 32px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
  }
  .links {
    display: flex;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .nav {
      order: 3;
      width: 100%;
      margin-right: 0;
    }
    .brand {
      margin-right: auto;
    }
  }
</style>
