{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bun run sync:changelog && blume dev",
    "build": "bun run sync:changelog && blume build",
    "preview": "blume preview",
    "doctor": "blume doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:changelog": "mkdir -p docs/_generated && sed 1,2d ../../packages/astro-eclipse/CHANGELOG.md > docs/_generated/changelog.md"
  },
  "dependencies": {
    "astro-eclipse": "workspace:*",
    "blume": "2.2.4"
  }
}
